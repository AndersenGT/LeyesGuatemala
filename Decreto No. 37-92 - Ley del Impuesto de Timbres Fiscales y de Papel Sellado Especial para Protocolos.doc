            <td><font size="2"></p><p style="text-align: justify; margin-top: 0px;"><br />Q. 100.00</p><p style="text-align: justify; margin-top: 0px;"><br /></p><p style="text-align: justify; margin-top: 0px;"><br />Q. 25.00</font></td>
        </tr>

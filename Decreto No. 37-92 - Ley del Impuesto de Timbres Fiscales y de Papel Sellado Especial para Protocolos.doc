        </tr>
        <tr>
            <td><font size="2">17.</font></td>
            <td><font size="2">Testimonios de las escrituras públicas de constitución, transformación, modificación, liquidación o fusión de sociedades mercantiles, en la primera hoja.</font></td>
            <td><font size="2">Q. 250.00</font></td>

			<p style="text-align: justify;"><span style="fontsize:7.5pt"><span style="fontsize:11.0pt">De un a&ntilde;o un d&iacute;a a dos a&ntilde;os</span></span></p>
			</td>
			<td>
			<p style="text-align: justify;"><span style="fontsize:12pt"><span style="fontsize:11.0pt">1.8%</span></span></p>
			</td>
		</tr>
		<tr>
			<td>
			<p style="text-align: justify;"><span style="fontsize:12pt"><span style="fontsize:11.0pt">3.</span></span></p>
			</td>
			<td>
			<p style="text-align: justify;"><span style="fontsize:7.5pt"><span style="fontsize:11.0pt">De dos a&ntilde;os un d&iacute;a a tres a&ntilde;os</span></span></p>
			</td>
			<td>
			<p style="text-align: justify;"><span style="fontsize:12pt"><span style="fontsize:11.0pt">1.6%</span></span></p>
			</td>
		</tr>
